# Phase 0 Caddyfile: HTTP only on :80 (automatic TLS is configured in Phase 9).
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# API server (NestJS) — global prefix is /api (so /api/health, /api/ready).
	# This also routes the databases realtime websocket: the socket.io gateway is
	# mounted at path /api/realtime, so it falls under this handle. Caddy's
	# reverse_proxy forwards Connection/Upgrade headers automatically, so the
	# websocket upgrade reaches the API with no extra rule.
	handle /api/* {
		reverse_proxy api:3001
	}

	# Sync server (Hocuspocus) websocket endpoint.
	handle /collab* {
		reverse_proxy sync:3002
	}

	# MinIO object storage, exposed through the single entrypoint so presigned
	# upload (PUT) / download (GET) URLs are reachable from the browser. The API
	# signs presigned URLs against S3_PUBLIC_ENDPOINT=http://<host>:<port> with
	# path-style addressing, so the bucket name is the FIRST path segment
	# (`/inclination/...`). We forward that path UNCHANGED to MinIO (no prefix
	# strip) so the request path matches what was signed — SigV4 signs the path,
	# so any rewrite here would invalidate the signature.
	handle /inclination/* {
		reverse_proxy minio:9000
	}

	# Sync server health, exposed through the single entrypoint: /sync/health ->
	# sync :3002 /health (handle_path strips the /sync prefix).
	handle_path /sync/* {
		reverse_proxy sync:3002
	}

	# Single-page app: serve static build, fall back to index.html for routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
