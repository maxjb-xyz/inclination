# Phase 9 Caddyfile: serves the app over HTTPS, parameterized by APP_DOMAIN.
#
# TLS mode is chosen by two env vars (substituted at load time):
#   APP_DOMAIN         — the site address Caddy serves (default: localhost).
#   CADDY_TLS_INTERNAL — when "1", use Caddy's internal CA (self-signed) so HTTPS
#                        works on localhost / behind no public DNS. When unset/0,
#                        Caddy's automatic HTTPS (Let's Encrypt / ZeroSSL) applies
#                        for the real domain in APP_DOMAIN.
#
# How the switch works without two files: we always `import` the snippet named by
# {$CADDY_TLS_SNIPPET}. setup-env / compose set it to "tls_internal" for localhost
# (which expands `tls internal`) or "tls_auto" for a real domain (a no-op, letting
# Caddy's default automatic HTTPS take over). Both snippets are defined below.
{
	admin off
	# Automatic HTTPS stays ON (the default). For a real APP_DOMAIN, Caddy obtains
	# a publicly-trusted cert automatically and redirects HTTP->HTTPS. For
	# localhost, the tls_internal snippet swaps in the internal CA.
	email {$ACME_EMAIL:admin@localhost}
}

# --- TLS mode snippets (selected per-environment via {$CADDY_TLS_SNIPPET}) ------
# Local / gate: self-signed cert from Caddy's internal CA. HTTPS works on
# https://localhost without external DNS or ACME.
(tls_internal) {
	tls internal
}

# Real domain: no explicit tls directive — Caddy's automatic HTTPS manages a
# publicly-trusted certificate for {$APP_DOMAIN}. This snippet is intentionally
# empty so the import resolves cleanly.
(tls_auto) {
}

# --- Shared route set (identical to the previous HTTP config) -------------------
(app_routes) {
	encode gzip

	# API server (NestJS) — global prefix is /api (so /api/health, /api/ready).
	# Also routes the databases realtime websocket (socket.io at /api/realtime):
	# reverse_proxy forwards Connection/Upgrade headers, so the upgrade reaches it.
	handle /api/* {
		reverse_proxy api:3001
	}

	# Sync server (Hocuspocus) websocket endpoint.
	handle /collab* {
		reverse_proxy sync:3002
	}

	# MinIO object storage, exposed through the single entrypoint so presigned
	# upload (PUT) / download (GET) URLs are reachable from the browser. The path
	# (/inclination/...) is forwarded UNCHANGED so the SigV4-signed path matches.
	handle /inclination/* {
		reverse_proxy minio:9000
	}

	# Sync server health: /sync/health -> sync :3002 /health (prefix stripped).
	handle_path /sync/* {
		reverse_proxy sync:3002
	}

	# Single-page app: serve static build, fall back to index.html for routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$APP_DOMAIN:localhost} {
	import {$CADDY_TLS_SNIPPET:tls_internal}
	import app_routes
}
