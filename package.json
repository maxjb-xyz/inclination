{
  "name": "inclination",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, real-time-collaborative Notion alternative.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm run build:packages && pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present --filter=!@inclination/e2e run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm --filter @inclination/e2e run test",
    "db:generate": "pnpm --filter @inclination/db run generate",
    "db:migrate": "pnpm --filter @inclination/db run migrate:deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
