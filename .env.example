# ─────────────────────────────────────────────────────────────
# Inclination — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# Public hostname Caddy serves (use "localhost" for local dev).
APP_DOMAIN=localhost
# Port Caddy listens on for HTTP (local/dev). TLS/443 is configured in Phase 9.
CADDY_HTTP_PORT=8080

# ── PostgreSQL ──
POSTGRES_USER=inclination
POSTGRES_PASSWORD=inclination_dev_pw
POSTGRES_DB=inclination
# Connection string used by API + sync (host "postgres" = compose service name).
DATABASE_URL=postgresql://inclination:inclination_dev_pw@postgres:5432/inclination?schema=public

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=inclination
MINIO_ROOT_PASSWORD=inclination_dev_pw
MINIO_BUCKET=inclination
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inclination
S3_SECRET_KEY=inclination_dev_pw
S3_FORCE_PATH_STYLE=true

# ── API server ──
API_PORT=3001
# Secrets for JWT (Phase 1). Generate strong values for real deployments.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# ── Sync server ──
SYNC_PORT=3002

# ── Web (build-time) ──
# Base URL the SPA uses to reach the API/collab through Caddy.
VITE_API_BASE=/api
VITE_COLLAB_URL=/collab
