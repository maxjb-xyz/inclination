# ─────────────────────────────────────────────────────────────
# Inclination — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# Public hostname Caddy serves (use "localhost" for local dev; set to your real
# domain, e.g. notes.example.com, for automatic Let's Encrypt HTTPS).
APP_DOMAIN=localhost
# TLS mode the Caddyfile imports:
#   tls_internal — Caddy self-signed cert (use for localhost / local dev).
#   tls_auto     — automatic public HTTPS (use when APP_DOMAIN is a real domain).
CADDY_TLS_SNIPPET=tls_internal
# Contact email for Let's Encrypt (only used when CADDY_TLS_SNIPPET=tls_auto).
ACME_EMAIL=admin@localhost
# Host port mapped to Caddy :443 (HTTPS — the primary entrypoint).
CADDY_HTTPS_PORT=8443
# Host port mapped to Caddy :80 (HTTP; ACME challenge + HTTP->HTTPS redirect).
CADDY_HTTP_PORT=8080
#
# ── Behind your OWN reverse proxy (Cloudflare Tunnel, nginx, Traefik, …) ──
# If something else already terminates TLS, run Caddy as a plain-HTTP internal
# router instead. Uncomment these three lines (and point your proxy/tunnel at the
# caddy container's port 80 = host ${CADDY_HTTP_PORT}), then set the three public
# URLs below (APP_BASE_URL / CORS_ORIGIN / S3_PUBLIC_ENDPOINT / OIDC_REDIRECT_URI)
# to your PUBLIC https URL, e.g. https://notes.example.com:
#   APP_DOMAIN=:80
#   CADDY_TLS_SNIPPET=tls_auto

# ── PostgreSQL ──
POSTGRES_USER=inclination
POSTGRES_PASSWORD=inclination_dev_pw
POSTGRES_DB=inclination
# Connection string used by API + sync (host "postgres" = compose service name).
DATABASE_URL=postgresql://inclination:inclination_dev_pw@postgres:5432/inclination?schema=public

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=inclination
MINIO_ROOT_PASSWORD=inclination_dev_pw
MINIO_BUCKET=inclination
S3_ENDPOINT=http://minio:9000
# Browser-reachable endpoint presigned URLs are signed against (Caddy → MinIO).
# Must match the origin the browser uses to reach the app (HTTPS by default).
S3_PUBLIC_ENDPOINT=https://localhost:8443
S3_REGION=us-east-1
S3_ACCESS_KEY=inclination
S3_SECRET_KEY=inclination_dev_pw
S3_FORCE_PATH_STYLE=true

# ── API server ──
API_PORT=3001
# Public base URL the SPA is served from (used to build links in emails).
APP_BASE_URL=https://localhost:8443
# Origin allowed by CORS (defaults to APP_BASE_URL).
CORS_ORIGIN=https://localhost:8443
# Secret for signing JWT access tokens (Phase 1). REQUIRED in production — the
# API refuses to boot with NODE_ENV=production if this is empty or a known
# default. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Token lifetimes (seconds).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
EMAIL_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600
INVITE_TOKEN_TTL=604800

# ── OIDC (optional; leave blank to disable). Generic OpenID Connect. ──
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost:8443/api/auth/oidc/callback

# ── Email (optional; blank SMTP_URL uses an in-memory capture transport) ──
SMTP_URL=
MAIL_FROM=Inclination <no-reply@localhost>

# ── Sync server ──
SYNC_PORT=3002

# ── Web (build-time) ──
# Base URL the SPA uses to reach the API/collab through Caddy.
VITE_API_BASE=/api
VITE_COLLAB_URL=/collab
