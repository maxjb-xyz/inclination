# ─────────────────────────────────────────────────────────────
# Inclination — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# ╔═════════════════════════════════════════════════════════════╗
# ║  THE ONE THING TO SET: your public URL.                      ║
# ║  Everything the browser/API needs (base URL, CORS, OIDC      ║
# ║  redirect, presigned-upload signing) is derived from this    ║
# ║  by docker-compose.yml — set it once, here.                  ║
# ╚═════════════════════════════════════════════════════════════╝
# Local default (self-signed HTTPS on localhost):
PUBLIC_URL=https://localhost:8443
# Public deployment: set it to your real origin, e.g.
#   PUBLIC_URL=https://notes.example.com

# ── How TLS is served (Caddy) ──
# APP_DOMAIN is the address Caddy listens on, and the TLS mode:
#   localhost            + CADDY_TLS_SNIPPET=tls_internal  → self-signed (default, local)
#   notes.example.com    + CADDY_TLS_SNIPPET=tls_auto      → automatic Let's Encrypt
#   :80                  + CADDY_TLS_SNIPPET=tls_auto      → plain HTTP behind YOUR
#                          reverse proxy / Cloudflare Tunnel (it terminates TLS;
#                          point it at the caddy container's port 80). For the
#                          turnkey tunnel, the docker-compose.cloudflared.yml
#                          overlay sets these two for you — then you only set
#                          PUBLIC_URL + CLOUDFLARE_TUNNEL_TOKEN.
APP_DOMAIN=localhost
CADDY_TLS_SNIPPET=tls_internal
# Contact email for Let's Encrypt (only used when CADDY_TLS_SNIPPET=tls_auto).
ACME_EMAIL=admin@localhost
# Host ports mapped to Caddy (HTTPS primary; HTTP for ACME challenge / redirect).
CADDY_HTTPS_PORT=8443
CADDY_HTTP_PORT=8080

# ── Container images ──
# By default the stack PULLS prebuilt images from GHCR (no local build). Override
# to pin a published version, point at your own registry/fork, or a local build:
#   INCLINATION_NODE_IMAGE=ghcr.io/maxjb-xyz/inclination-node:v1.2.0
#   INCLINATION_WEB_IMAGE=ghcr.io/maxjb-xyz/inclination-web:v1.2.0
# (To build from source instead, add: -f docker-compose.build.yml  to your compose
#  command — see README "Build from source".)

# ── PostgreSQL ──
POSTGRES_USER=inclination
POSTGRES_PASSWORD=inclination_dev_pw
POSTGRES_DB=inclination
# Connection string used by API + sync (host "postgres" = compose service name).
DATABASE_URL=postgresql://inclination:inclination_dev_pw@postgres:5432/inclination?schema=public

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=inclination
MINIO_ROOT_PASSWORD=inclination_dev_pw
MINIO_BUCKET=inclination
S3_ENDPOINT=http://minio:9000
# (S3_PUBLIC_ENDPOINT — the browser-reachable endpoint presigned URLs are signed
#  against — is derived from PUBLIC_URL by docker-compose.yml. No need to set it.)
S3_REGION=us-east-1
S3_ACCESS_KEY=inclination
S3_SECRET_KEY=inclination_dev_pw
S3_FORCE_PATH_STYLE=true

# ── API server ──
API_PORT=3001
# (APP_BASE_URL and CORS_ORIGIN are derived from PUBLIC_URL by docker-compose.yml.)
# Secret for signing JWT access tokens (Phase 1). REQUIRED in production — the
# API refuses to boot with NODE_ENV=production if this is empty or a known
# default. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Token lifetimes (seconds).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
EMAIL_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600
INVITE_TOKEN_TTL=604800

# ── OIDC (optional; leave blank to disable). Generic OpenID Connect. ──
# (OIDC_REDIRECT_URI is derived as PUBLIC_URL + /api/auth/oidc/callback by
#  docker-compose.yml — register THAT as the callback URL at your IdP.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Email (optional; blank SMTP_URL uses an in-memory capture transport) ──
SMTP_URL=
MAIL_FROM=Inclination <no-reply@localhost>

# ── Sync server ──
SYNC_PORT=3002

# ── Web (build-time) ──
# Base URL the SPA uses to reach the API/collab through Caddy.
VITE_API_BASE=/api
VITE_COLLAB_URL=/collab
