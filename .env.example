# ─────────────────────────────────────────────────────────────
# Inclination — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# Public hostname Caddy serves (use "localhost" for local dev).
APP_DOMAIN=localhost
# Port Caddy listens on for HTTP (local/dev). TLS/443 is configured in Phase 9.
CADDY_HTTP_PORT=8080

# ── PostgreSQL ──
POSTGRES_USER=inclination
POSTGRES_PASSWORD=inclination_dev_pw
POSTGRES_DB=inclination
# Connection string used by API + sync (host "postgres" = compose service name).
DATABASE_URL=postgresql://inclination:inclination_dev_pw@postgres:5432/inclination?schema=public

# ── MinIO (S3-compatible object storage) ──
MINIO_ROOT_USER=inclination
MINIO_ROOT_PASSWORD=inclination_dev_pw
MINIO_BUCKET=inclination
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inclination
S3_SECRET_KEY=inclination_dev_pw
S3_FORCE_PATH_STYLE=true

# ── API server ──
API_PORT=3001
# Public base URL the SPA is served from (used to build links in emails).
APP_BASE_URL=http://localhost:8080
# Origin allowed by CORS (defaults to APP_BASE_URL).
CORS_ORIGIN=http://localhost:8080
# Secret for signing JWT access tokens (Phase 1). REQUIRED in production — the
# API refuses to boot with NODE_ENV=production if this is empty or a known
# default. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Token lifetimes (seconds).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
EMAIL_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600
INVITE_TOKEN_TTL=604800

# ── OIDC (optional; leave blank to disable). Generic OpenID Connect. ──
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback

# ── Email (optional; blank SMTP_URL uses an in-memory capture transport) ──
SMTP_URL=
MAIL_FROM=Inclination <no-reply@localhost>

# ── Sync server ──
SYNC_PORT=3002

# ── Web (build-time) ──
# Base URL the SPA uses to reach the API/collab through Caddy.
VITE_API_BASE=/api
VITE_COLLAB_URL=/collab
