// Inclination database schema.
// Phase 0 establishes the datasource + client generation with a minimal model.
// Real entities (User, Workspace, Page, Database, …) arrive in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trivial table that lets `/ready` confirm the schema is migrated and the
/// database is reachable. Superseded by real models in Phase 1+.
model HealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
}
