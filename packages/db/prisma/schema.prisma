// Inclination database schema.
// Phase 0 establishes the datasource + client generation with a minimal model.
// Real entities (User, Workspace, Page, Database, …) arrive in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trivial table that lets `/ready` confirm the schema is migrated and the
/// database is reachable.
model HealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Identity & workspaces (spec §5)
// ─────────────────────────────────────────────────────────────

enum WorkspaceRole {
  owner
  admin
  member
  guest
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  oidcSubject     String?
  oidcIssuer      String?
  displayName     String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   WorkspaceMember[]
  refreshTokens RefreshToken[]

  @@unique([oidcIssuer, oidcSubject])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invitations Invitation[]
  pages       Page[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedById String?
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Pages & content (spec §4, §9)
// ─────────────────────────────────────────────────────────────

enum PageType {
  document
  database
  row
}

model Page {
  id          String    @id @default(uuid())
  workspaceId String
  parentId    String?
  type        PageType  @default(document)
  title       String    @default("")
  icon        String?
  cover       String?
  sortKey     String // fractional-index string for ordering among siblings
  archivedAt  DateTime?
  createdById String
  editedById  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Page?         @relation("PageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]        @relation("PageChildren")
  content   PageContent?
  snapshots PageSnapshot[]

  // Phase 4 — backlinks (spec §7). A page references other pages via pageLink /
  // page-mention nodes; the editor PUTs the set and the target shows backlinks.
  outgoingRefs PageReference[] @relation("PageOutgoingRefs")
  incomingRefs PageReference[] @relation("PageIncomingRefs")

  // Phase 5 — databases (spec §5). A `database` page owns one Database; a `row`
  // page owns its Cells and participates in RelationLinks on either side.
  database  Database?      @relation("DatabaseContainer")
  cells     Cell[]         @relation("RowCells")
  fromLinks RelationLink[] @relation("RelationLinkFromRow")
  toLinks   RelationLink[] @relation("RelationLinkToRow")

  // Phase 6 — sharing + comments (spec §5). Explicit per-page Permission grants
  // (inherited down the tree) and Comments anchored to this page.
  permissions Permission[]
  comments    Comment[]

  // Phase 7 — search + files (spec §5). A page's 1:1 SearchIndex row (title +
  // extracted body + cell text) and any Attachments uploaded against it.
  searchIndex SearchIndex?
  attachments Attachment[]

  // Phase 8 — publishing (spec §5). A page may have one PublicShare exposing it
  // (and optionally its descendants) at a public, unauthenticated slug.
  publicShare PublicShare?

  @@index([workspaceId, parentId, archivedAt])
  @@index([parentId, sortKey])
}

// Phase 4 — Page references / backlinks (spec §7). One row per (fromPage →
// toPage) directed reference. The web app recomputes the outgoing set on edit
// and the target page lists incoming references as "backlinks". Both sides
// cascade-delete with their page so references never dangle.
model PageReference {
  id         String   @id @default(uuid())
  fromPageId String
  toPageId   String
  createdAt  DateTime @default(now())

  fromPage Page @relation("PageOutgoingRefs", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage   Page @relation("PageIncomingRefs", fields: [toPageId], references: [id], onDelete: Cascade)

  @@unique([fromPageId, toPageId])
  @@index([toPageId])
}

// Phase 2 stored the editor doc as ProseMirror/Tiptap JSON (`doc`). Phase 3 makes
// Yjs authoritative for the page body: the collaborative document state is
// persisted as a Yjs update binary in `ydocState` (spec §4). `doc` is retained
// for back-compat but is no longer written by the collaborative editor.
model PageContent {
  pageId    String   @id
  doc       Json     @default("{}")
  ydocState Bytes?
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// Point-in-time snapshots of a page's Yjs document (spec §5). The sync server
// writes these (throttled) so version history / restore can be built later.
model PageSnapshot {
  id           String   @id @default(uuid())
  pageId       String
  ydocSnapshot Bytes
  label        String?
  authorId     String?
  createdAt    DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

// ─────────────────────────────────────────────────────────────
// Phase 5 — Databases / collections (spec §5)
// ─────────────────────────────────────────────────────────────

// A Database is the relational "collection" attached 1:1 to a container Page of
// type `database`. Its rows are Pages of type `row` whose parentId points at the
// container page (or a parent row for sub-items). Property/View/Cell/RelationLink
// hang off it. Deleting the container page cascades the whole collection away.
model Database {
  pageId             String  @id
  defaultViewId      String?
  subitemsEnabled    Boolean @default(false)
  subitemsPropertyId String?

  page       Page       @relation("DatabaseContainer", fields: [pageId], references: [id], onDelete: Cascade)
  properties Property[]
  views      View[]
}

// A typed column of a Database. `type` is one of the spec's property types and
// `config` (JSONB) holds the per-type configuration (select options, number
// format, relation target, rollup spec, formula expression, …). `isPrimary`
// marks the title column. Values live in Cell rows keyed by (rowPage, property).
model Property {
  id         String  @id @default(uuid())
  databaseId String
  name       String
  type       String
  config     Json    @default("{}")
  order      Int
  isPrimary  Boolean @default(false)

  database      Database       @relation(fields: [databaseId], references: [pageId], onDelete: Cascade)
  cells         Cell[]
  relationLinks RelationLink[]

  @@index([databaseId])
}

// A single populated value: one row per (rowPage, property). The row's identity
// is its Page (type `row`); `value` (JSONB) is the typed cell value. Indexed by
// property for filter/sort performance (spec §9).
model Cell {
  id         String @id @default(uuid())
  rowPageId  String
  propertyId String
  value      Json

  rowPage  Page     @relation("RowCells", fields: [rowPageId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([rowPageId, propertyId])
  @@index([propertyId])
}

// A directed edge of a `relation`-type property. Two-way relations store the
// mirrored edge under the paired property; rollups aggregate over these links;
// dependencies are relations whose config marks `isDependency`. fromRow/toRow
// are row Pages. Cascades from both the property and either endpoint page.
model RelationLink {
  id         String @id @default(uuid())
  propertyId String
  fromRowId  String
  toRowId    String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromRow  Page     @relation("RelationLinkFromRow", fields: [fromRowId], references: [id], onDelete: Cascade)
  toRow    Page     @relation("RelationLinkToRow", fields: [toRowId], references: [id], onDelete: Cascade)

  @@unique([propertyId, fromRowId, toRowId])
  @@index([propertyId, fromRowId])
  @@index([propertyId, toRowId])
}

// A saved view over a Database. `type` is table|board|calendar|gallery; `config`
// (JSONB) holds visible/ordered properties, the filter AND/OR tree, sorts,
// group_by, calendar date_property, gallery cover/size and page size. A linked
// view may reference a Database owned by a different page (data is not copied).
model View {
  id         String @id @default(uuid())
  databaseId String
  type       String
  name       String
  order      Int
  config     Json   @default("{}")

  database Database @relation(fields: [databaseId], references: [pageId], onDelete: Cascade)

  @@index([databaseId])
}

// ─────────────────────────────────────────────────────────────
// Phase 6 — Comments, sharing & permissions (spec §5)
// ─────────────────────────────────────────────────────────────

// An explicit access grant on a page (spec §5). The shared resolver walks a
// page's ancestors and the NEAREST matching grant wins; if none, the workspace
// role default applies (guests get no default — page-grant only).
//   subjectType: `user` (subjectId = userId) | `workspace` (subjectId =
//   workspaceId) | `public` (subjectId = null; Phase 8 publishing).
//   role: full | edit | comment | read.
// Cascades away with its page so grants never dangle.
model Permission {
  id          String   @id @default(uuid())
  pageId      String
  subjectType String // user | workspace | public
  subjectId   String? // userId / workspaceId; null for `public`
  role        String // full | edit | comment | read
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, subjectType, subjectId])
  @@index([pageId])
}

// A comment on a page (spec §5). Page-level when `blockAnchor` is null; inline
// when it carries {blockId, from, to}. Threaded via `threadId`
// (root = its own id) and `parentCommentId` (the replied-to comment). `body` is
// rich-text JSON; `resolvedAt` toggles resolution. Cascades with its page.
model Comment {
  id              String    @id @default(uuid())
  pageId          String
  blockAnchor     Json?
  threadId        String
  parentCommentId String?
  authorId        String
  body            Json
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([threadId])
}

// An in-app notification for a user (spec §5). `type` is mention |
// comment_reply | invite | share | …; `sourceRef` (JSON) points at the
// originating entity (e.g. {commentId, pageId}); `readAt` toggles read state.
model Notification {
  id          String    @id @default(uuid())
  recipientId String
  type        String
  sourceRef   Json
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
}

// ─────────────────────────────────────────────────────────────
// Phase 7 — Search, files & version history (spec §5, §6, §9)
// ─────────────────────────────────────────────────────────────

// Full-text search index (spec §5/§6): one row per page holding the page title,
// the plain text extracted from the Yjs body on save (by the sync server), and a
// concatenation of its database cell text. The actual search column is a Postgres
// `tsvector` (`tsv`) that Prisma cannot model natively: the migration adds the
// column, a BEFORE INSERT/UPDATE trigger that recomputes it from
// `to_tsvector('english', title || ' ' || bodyText)`, and a GIN index over it.
// We keep the scalar fields here (writers set title/bodyText; the trigger owns
// `tsv`) plus an `Unsupported("tsvector")?` mapping so Prisma preserves the
// column on future migrations.
model SearchIndex {
  pageId      String   @id
  workspaceId String
  title       String   @default("")
  bodyText    String   @default("")
  tsv         Unsupported("tsvector")?
  updatedAt   DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Phase 8 — Publishing & synced blocks (spec §5, §6)
// ─────────────────────────────────────────────────────────────

// A page's public, read-only publication (spec §5). When `published`, the page
// is served (without authentication) at `GET /api/public/{slug}`. We store a
// client-rendered HTML snapshot (`publishedHtml`) + title at publish time so the
// public endpoint can serve content without decoding the Yjs body or leaking the
// editor stack to logged-out viewers (re-publishing refreshes the snapshot).
//   includeSubpages → the public view may list published descendants.
//   allowDuplicate  → surfaced as a flag so a future "duplicate into my
//                      workspace" affordance can be gated by the publisher.
// 1:1 with its Page; cascades away with the page so a share never dangles.
model PublicShare {
  id              String   @id @default(uuid())
  pageId          String   @unique
  slug            String   @unique
  published       Boolean  @default(true)
  includeSubpages Boolean  @default(false)
  allowDuplicate  Boolean  @default(false)
  publishedHtml   String?
  publishedTitle  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([slug])
}

// A synced block's own Yjs document (spec §5/§6), keyed `synced:{id}` and served
// by the sync server to every host page that embeds it. `ydocState` holds the
// Yjs update binary (null until first edited). Scoped to a workspace; the sync
// server authorizes a connection by workspace membership.
model SyncedBlock {
  id          String   @id @default(uuid())
  workspaceId String
  ydocState   Bytes?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

// An uploaded file/image (spec §5, §9). Created when a presigned upload URL is
// issued; the browser PUTs bytes directly to MinIO under `objectKey`
// (`{workspaceId}/{uuid}/{filename}`). `pageId` is nullable and SetNull on page
// delete so an attachment survives its page being removed (and orphaned objects
// can be reaped later). Authorization for download goes through the page (via
// resolvePageAccess) or workspace membership when there is no page.
model Attachment {
  id          String   @id @default(uuid())
  pageId      String?
  workspaceId String
  objectKey   String   @unique
  filename    String
  mime        String
  size        Int
  uploaderId  String
  createdAt   DateTime @default(now())

  page Page? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([workspaceId])
}
